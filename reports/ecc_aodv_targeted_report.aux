\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}When does each protocol win?}{17}{subsection.8.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}The PDR vs Throughput Tradeoff}{17}{subsection.8.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Why Loss Improvements are Small in Absolute Terms}{17}{subsection.8.3}\protected@file@percent }
