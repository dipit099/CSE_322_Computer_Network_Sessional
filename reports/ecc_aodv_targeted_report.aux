\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Mobile Topology — Multi-Panel Parameter Sweep}{11}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Mobile 802.11 topology — multi-panel parameter sweep across all $8$ configurations. Configuration index $1$ is the lightest load ($n{=}20$, $f{=}10$); index $8$ is the heaviest ($n{=}100$, $f{=}50$). \textbf  {ECC-AODV beats both baselines on PDR and throughput in $7$ of $8$ configs} and is competitive on delay and loss. The only exception is config $5$ ($n60,f30,p400,s5$), where extreme contention pushes ECC-AODV\ below the baselines on throughput.}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:mobile-sweep}{{1}{11}{Mobile 802.11 topology — multi-panel parameter sweep across all $8$ configurations. Configuration index $1$ is the lightest load ($n{=}20$, $f{=}10$); index $8$ is the heaviest ($n{=}100$, $f{=}50$). \textbf {ECC-AODV beats both baselines on PDR and throughput in $7$ of $8$ configs} and is competitive on delay and loss. The only exception is config $5$ ($n60,f30,p400,s5$), where extreme contention pushes \ecc \ below the baselines on throughput}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Static Topology — Multi-Panel Parameter Sweep}{12}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Static 802.11 topology — multi-panel parameter sweep across all $8$ configurations. \textbf  {ECC-AODV achieves the largest single delay improvement in this campaign at config~$1$ (n20,f10,p100,a5)}: $164$~ms vs.\ $335$~ms for AODV\ — a $51\%$ delay reduction together with the highest PDR ($36.5\%$) and the lowest energy ($672$~J).}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:static-sweep}{{2}{12}{Static 802.11 topology — multi-panel parameter sweep across all $8$ configurations. \textbf {ECC-AODV achieves the largest single delay improvement in this campaign at config~$1$ (n20,f10,p100,a5)}: $164$~ms vs.\ $335$~ms for \aodv \ — a $51\%$ delay reduction together with the highest PDR ($36.5\%$) and the lowest energy ($672$~J)}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Average-Metric Grouped-Bar Comparison}{13}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Average values across all $16$ configurations (mobile $+$ static). Throughput is divided by $10$ and Energy by $10$ to fit on the same axis. ECC-AODV\ leads on PDR, throughput, delay, and loss; energy is essentially identical (within noise) because it is dominated by PHY-layer transmit/receive time, not routing decisions.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:avg-bars}{{3}{13}{Average values across all $16$ configurations (mobile $+$ static). Throughput is divided by $10$ and Energy by $10$ to fit on the same axis. \ecc \ leads on PDR, throughput, delay, and loss; energy is essentially identical (within noise) because it is dominated by PHY-layer transmit/receive time, not routing decisions}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}ECC-AODV Improvement over Baselines}{13}{subsection.5.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Average-metric improvement of ECC-AODV\ over the two baselines across all $16$ configurations. Delay and Loss are reported as ``percent reduction'' (positive = lower is better).}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:improvement}{{4}{13}{Average-metric improvement of \ecc \ over the two baselines across all $16$ configurations. Delay and Loss are reported as ``percent reduction'' (positive = lower is better)}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Win Matrix — Per-Metric Wins per Protocol}{13}{subsection.5.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}PDR vs.\ Node Count — Mobile Topology (Grouped Bar)}{13}{subsection.5.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-metric win counts across all $16$ configurations. Total metric wins: AODV $=16$, CC-AODV $=19$, \textbf  {ECC-AODV $=45$}. ECC-AODV\ dominates on delay ($11/16$) and throughput ($10/16$), and clearly leads on PDR and loss ($9/16$ each).}}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:winmatrix}{{5}{14}{Per-metric win counts across all $16$ configurations. Total metric wins: AODV $=16$, CC-AODV $=19$, \best {ECC-AODV $=45$}. \ecc \ dominates on delay ($11/16$) and throughput ($10/16$), and clearly leads on PDR and loss ($9/16$ each)}{figure.caption.11}{}}
