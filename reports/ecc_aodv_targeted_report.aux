\@writefile{toc}{\contentsline {subsection}{\numberline {8.5}Limitations and Future Work}{18}{subsection.8.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Mobile topology: PDR averaged within node-count groups. ECC-AODV\ leads at every scale; the widest gap is at $n{=}40$ ($33.5\%$ vs\ $26.1\%$ for AODV) — the mid-density regime where MMPS and ATM gain the most. At $n{=}100$ all protocols collapse, but ECC-AODV\ still delivers $1.21\%$ vs.\ $\sim 0.93\%$ average.}}{18}{figure.caption.15}\protected@file@percent }
\newlabel{fig:pdr-nodes-mob}{{6}{18}{Mobile topology: PDR averaged within node-count groups. \ecc \ leads at every scale; the widest gap is at $n{=}40$ ($33.5\%$ vs\^^M$26.1\%$ for AODV) — the mid-density regime where MMPS and ATM gain the most. At $n{=}100$ all protocols collapse, but \ecc \ still delivers $1.21\%$ vs.\ $\sim 0.93\%$ average}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.6}Throughput vs.\ Node Count — Mobile Topology}{19}{subsection.8.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Mobile topology: throughput averaged by node count. ECC-AODV\ gains most at $n{=}40$ ($+32\%$ over AODV) and $n{=}80$ ($+18\%$). At $n{=}60$ ECC-AODV\ dips below baselines because QACD drops too many RREQs under sustained high offered-load at low mobility — the only systematic failure regime.}}{19}{figure.caption.16}\protected@file@percent }
\newlabel{fig:tput-nodes-mob}{{7}{19}{Mobile topology: throughput averaged by node count. \ecc \ gains most at $n{=}40$ ($+32\%$ over AODV) and $n{=}80$ ($+18\%$). At $n{=}60$ \ecc \ dips below baselines because QACD drops too many RREQs under sustained high offered-load at low mobility — the only systematic failure regime}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.7}PDR vs.\ Flow Count — Mobile Topology}{19}{subsection.8.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Mobile topology: PDR by flow count. At low flow count (10 flows), ECC-AODV\ leads by $+8.7$ pp over AODV — this is where MMPS's best-RREP selection matters most: few flows, each with multiple RREP responses available. At higher flow counts the medium is saturated and all three protocols converge.}}{19}{figure.caption.17}\protected@file@percent }
\newlabel{fig:pdr-flows-mob}{{8}{19}{Mobile topology: PDR by flow count. At low flow count (10 flows), \ecc \ leads by $+8.7$ pp over AODV — this is where MMPS's best-RREP selection matters most: few flows, each with multiple RREP responses available. At higher flow counts the medium is saturated and all three protocols converge}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.8}Throughput vs.\ Flow Count — Mobile Topology}{20}{subsection.8.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Mobile topology: throughput by flow count. ECC-AODV\ shows the largest throughput advantage at $f{=}10$ ($+21\%$ over AODV) and $f{=}40$ ($+18\%$). At $f{=}30$ the QACD conservative mode suppresses some flows; at $f{=}50$ the channel collapses for all protocols.}}{20}{figure.caption.18}\protected@file@percent }
\newlabel{fig:tput-flows-mob}{{9}{20}{Mobile topology: throughput by flow count. \ecc \ shows the largest throughput advantage at $f{=}10$ ($+21\%$ over AODV) and $f{=}40$ ($+18\%$). At $f{=}30$ the QACD conservative mode suppresses some flows; at $f{=}50$ the channel collapses for all protocols}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.9}PDR by Node Count — Static Topology}{20}{subsection.8.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Static topology: PDR by node count. ECC-AODV\ leads most clearly at $n{=}20$ ($24.5\%$ vs.\ $21.3\%$ for AODV). In very dense static networks ($n{=}100$) all protocols are equally constrained by the medium.}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:pdr-nodes-sta}{{10}{20}{Static topology: PDR by node count. \ecc \ leads most clearly at $n{=}20$ ($24.5\%$ vs.\ $21.3\%$ for AODV). In very dense static networks ($n{=}100$) all protocols are equally constrained by the medium}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.10}PDR by Mobility Speed — Mobile Topology}{20}{subsection.8.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Mobile PDR split by speed category. At low speed, all three protocols are comparable. At high speed ($\geq 15$~m/s), ECC-AODV\ separates clearly: $18.6\%$ vs.\ $14.8$--$15.0\%$ for the baselines. ATM's dynamic threshold and MMPS's multi-RREP selection handle frequent topology changes better than the static threshold of CC-AODV.}}{21}{figure.caption.20}\protected@file@percent }
\newlabel{fig:pdr-speed}{{11}{21}{Mobile PDR split by speed category. At low speed, all three protocols are comparable. At high speed ($\geq 15$~m/s), \ecc \ separates clearly: $18.6\%$ vs.\ $14.8$--$15.0\%$ for the baselines. ATM's dynamic threshold and MMPS's multi-RREP selection handle frequent topology changes better than the static threshold of CC-AODV}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.11}ECC-AODV Gain over AODV by Node Count — Both Topologies}{21}{subsection.8.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Relative PDR improvement of ECC-AODV\ over AODV\ at each node-count level (positive $=$ ECC-AODV\ wins). Mobile $n{=}40$ and $n{=}100$ are the biggest winners. Static $n{=}20$ benefits strongly from MMPS's path selection in the sparse, multi-hop regime. Negative bars indicate configs where ECC-AODV\ marginally loses on average PDR; these are within noise.}}{21}{figure.caption.21}\protected@file@percent }
\newlabel{fig:gain-nodes}{{12}{21}{Relative PDR improvement of \ecc \ over \aodv \ at each node-count level (positive $=$ \ecc \ wins). Mobile $n{=}40$ and $n{=}100$ are the biggest winners. Static $n{=}20$ benefits strongly from MMPS's path selection in the sparse, multi-hop regime. Negative bars indicate configs where \ecc \ marginally loses on average PDR; these are within noise}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.12}Per-Config Throughput Comparison — All 16 Configs}{21}{subsection.8.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Throughput across all 16 configurations (M = mobile, S = static). ECC-AODV leads on 10 out of 16 configs. The conspicuous dip at M5 (n60,f30,p400,s5) is the QACD-saturation failure mode. S4 (n40,f30,p300,a3) is the only static config where AODV wins on throughput.}}{22}{figure.caption.22}\protected@file@percent }
\newlabel{fig:tput-all16}{{13}{22}{Throughput across all 16 configurations (M = mobile, S = static). ECC-AODV leads on 10 out of 16 configs. The conspicuous dip at M5 (n60,f30,p400,s5) is the QACD-saturation failure mode. S4 (n40,f30,p300,a3) is the only static config where AODV wins on throughput}{figure.caption.22}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.13}Per-Config PDR Comparison — All 16 Configs}{22}{subsection.8.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces PDR across all 16 configurations. ECC-AODV achieves the highest PDR in 9 of 16 configurations. The standout result is M3 (n40,f10,p100,s25) where ECC-AODV reaches $51.7\%$ vs.\ $38.8\%$ for AODV and $37.8\%$ for CC-AODV — the largest single-config lead in the entire campaign.}}{22}{figure.caption.23}\protected@file@percent }
\newlabel{fig:pdr-all16}{{14}{22}{PDR across all 16 configurations. ECC-AODV achieves the highest PDR in 9 of 16 configurations. The standout result is M3 (n40,f10,p100,s25) where ECC-AODV reaches $51.7\%$ vs.\ $38.8\%$ for AODV and $37.8\%$ for CC-AODV — the largest single-config lead in the entire campaign}{figure.caption.23}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.14}End-to-End Delay — All 16 Configs}{23}{subsection.8.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces End-to-end delay across all 16 configurations. The lowest point for ECC-AODV\ is S1 ($164$~ms) — the campaign's best single delay result, nearly half of AODV's $335$~ms. On the mobile side, ECC-AODV\ consistently trails CC-AODV at M1 but beats both at M3, M5, and M6.}}{23}{figure.caption.24}\protected@file@percent }
\newlabel{fig:delay-all16}{{15}{23}{End-to-end delay across all 16 configurations. The lowest point for \ecc \ is S1 ($164$~ms) — the campaign's best single delay result, nearly half of AODV's $335$~ms. On the mobile side, \ecc \ consistently trails CC-AODV at M1 but beats both at M3, M5, and M6}{figure.caption.24}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.15}Packet Loss — All 16 Configs}{23}{subsection.8.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Packet loss across all 16 configurations (lower is better). ECC-AODV achieves the lowest loss at M3 ($48.3\%$ vs.\ $61.2\%$ for AODV — a $21$~pp absolute reduction). Loss converges above $95\%$ at high-load configs where no routing-layer policy can recover.}}{23}{figure.caption.25}\protected@file@percent }
\newlabel{fig:loss-all16}{{16}{23}{Packet loss across all 16 configurations (lower is better). ECC-AODV achieves the lowest loss at M3 ($48.3\%$ vs.\ $61.2\%$ for AODV — a $21$~pp absolute reduction). Loss converges above $95\%$ at high-load configs where no routing-layer policy can recover}{figure.caption.25}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.16}Mobility Speed vs.\ PDR — All Mobile Configs}{23}{subsection.8.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Mobile PDR plotted against speed parameter. Each config is one point; multiple points can share the same speed (different node count / flow count). ECC-AODV's standout at $s{=}25$~m/s ($51.7\%$) demonstrates that its adaptive mechanisms handle high-mobility scenarios most effectively.}}{24}{figure.caption.26}\protected@file@percent }
\newlabel{fig:pdr-vs-speed-line}{{17}{24}{Mobile PDR plotted against speed parameter. Each config is one point; multiple points can share the same speed (different node count / flow count). ECC-AODV's standout at $s{=}25$~m/s ($51.7\%$) demonstrates that its adaptive mechanisms handle high-mobility scenarios most effectively}{figure.caption.26}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.17}Throughput vs.\ Speed — Mobile Topology}{24}{subsection.8.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Mobile throughput vs.\ speed parameter (one point per config). The ECC-AODV dip at $s{=}5$ (lower cluster) is config M5, the QACD saturation case. All protocols converge to very low throughput at $s{=}15$ when combined with $n{=}100$ nodes (M8). The wide vertical spread at the same speed value reflects the stronger effect of node count and flow count.}}{24}{figure.caption.27}\protected@file@percent }
\newlabel{fig:tput-vs-speed}{{18}{24}{Mobile throughput vs.\ speed parameter (one point per config). The ECC-AODV dip at $s{=}5$ (lower cluster) is config M5, the QACD saturation case. All protocols converge to very low throughput at $s{=}15$ when combined with $n{=}100$ nodes (M8). The wide vertical spread at the same speed value reflects the stronger effect of node count and flow count}{figure.caption.27}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.18}Static Topology: Throughput by Node Count}{25}{subsection.8.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Static topology: throughput averaged by node count. ECC-AODV\ leads at $n{=}20$ ($+24\%$ over CC-AODV, $+24\%$ over AODV) — the sparse static regime where MMPS has the most path diversity to exploit. At $n{=}40$ and $n{=}80$ ECC-AODV\ remains competitive; at $n{=}100$ CC-AODV falls furthest behind.}}{25}{figure.caption.28}\protected@file@percent }
\newlabel{fig:tput-nodes-sta}{{19}{25}{Static topology: throughput averaged by node count. \ecc \ leads at $n{=}20$ ($+24\%$ over CC-AODV, $+24\%$ over AODV) — the sparse static regime where MMPS has the most path diversity to exploit. At $n{=}40$ and $n{=}80$ \ecc \ remains competitive; at $n{=}100$ CC-AODV falls furthest behind}{figure.caption.28}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.19}Static Topology: Delay by Node Count}{25}{subsection.8.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Static topology: E2E delay by node count. The largest ECC-AODV advantage is at $n{=}20$ ($265$~ms vs.\ $353$~ms for AODV) driven entirely by S1's $164$~ms result (MMPS avoiding a congested relay node in the sparse network). At $n{=}40$ ECC-AODV\ leads by $\sim 20$~ms. Dense networks converge as all protocols queue at the same bottleneck links.}}{25}{figure.caption.29}\protected@file@percent }
\newlabel{fig:delay-nodes-sta}{{20}{25}{Static topology: E2E delay by node count. The largest ECC-AODV advantage is at $n{=}20$ ($265$~ms vs.\ $353$~ms for AODV) driven entirely by S1's $164$~ms result (MMPS avoiding a congested relay node in the sparse network). At $n{=}40$ \ecc \ leads by $\sim 20$~ms. Dense networks converge as all protocols queue at the same bottleneck links}{figure.caption.29}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.20}Mobile Topology: Delay by Node Count}{26}{subsection.8.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Mobile topology: E2E delay by node count. CC-AODV has the lowest delay at $n{=}20$ and $n{=}40$ because its fixed threshold sometimes produces shorter paths. ECC-AODV beats AODV at all node counts and beats CC-AODV at $n{=}60$, $n{=}80$, and $n{=}100$ — the regimes where MMPS avoids congested relays that inflate delay.}}{26}{figure.caption.30}\protected@file@percent }
\newlabel{fig:delay-nodes-mob}{{21}{26}{Mobile topology: E2E delay by node count. CC-AODV has the lowest delay at $n{=}20$ and $n{=}40$ because its fixed threshold sometimes produces shorter paths. ECC-AODV beats AODV at all node counts and beats CC-AODV at $n{=}60$, $n{=}80$, and $n{=}100$ — the regimes where MMPS avoids congested relays that inflate delay}{figure.caption.30}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.21}Mobile: PDR Gain over AODV — Per Flow Count}{26}{subsection.8.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Relative PDR gain over AODV by flow count (mobile topology). ECC-AODV is consistently ahead; its largest relative gain is at $f{=}10$ (+17\%) — MMPS selects the best of multiple competing RREPs when source nodes have few flows and many path choices. CC-AODV loses at $f{=}40$ where its fixed threshold over-blocks RREQs.}}{26}{figure.caption.31}\protected@file@percent }
\newlabel{fig:pdr-gain-flows}{{22}{26}{Relative PDR gain over AODV by flow count (mobile topology). ECC-AODV is consistently ahead; its largest relative gain is at $f{=}10$ (+17\%) — MMPS selects the best of multiple competing RREPs when source nodes have few flows and many path choices. CC-AODV loses at $f{=}40$ where its fixed threshold over-blocks RREQs}{figure.caption.31}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.22}Static: PDR Gain over AODV — Per Flow Count}{27}{subsection.8.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Relative PDR gain over AODV by flow count (static topology). ECC-AODV leads at low flows ($f{=}10$: $+17\%$). At $f{=}30$ both congestion-control protocols struggle vs.\ the bare AODV baseline — the medium-heavy static regime. CC-AODV is consistently worse than AODV at $f{=}30$ and $f{=}50$.}}{27}{figure.caption.32}\protected@file@percent }
\newlabel{fig:pdr-gain-flows-sta}{{23}{27}{Relative PDR gain over AODV by flow count (static topology). ECC-AODV leads at low flows ($f{=}10$: $+17\%$). At $f{=}30$ both congestion-control protocols struggle vs.\ the bare AODV baseline — the medium-heavy static regime. CC-AODV is consistently worse than AODV at $f{=}30$ and $f{=}50$}{figure.caption.32}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.23}Energy by Node Count — Mobile and Static Combined}{27}{subsection.8.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Average energy consumption by node count (mobile and static topologies combined). Energy scales almost exactly linearly with node count and is essentially \emph  {identical} across protocols — the three bars are barely distinguishable. This confirms that the routing-layer overhead of ATM/QACD/MMPS does not translate into any measurable radio energy cost.}}{27}{figure.caption.33}\protected@file@percent }
\newlabel{fig:energy-nodes}{{24}{27}{Average energy consumption by node count (mobile and static topologies combined). Energy scales almost exactly linearly with node count and is essentially \emph {identical} across protocols — the three bars are barely distinguishable. This confirms that the routing-layer overhead of ATM/QACD/MMPS does not translate into any measurable radio energy cost}{figure.caption.33}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.24}Protocol Comparison: Delay vs. Throughput Scatter}{27}{subsection.8.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Delay vs.\ Throughput scatter across all 48 data points. Ideal points are in the upper-left (high throughput, low delay). ECC-AODV (green circles) occupies the upper-left more densely than AODV (red squares) or CC-AODV (blue triangles). The point at $(164, 1299)$ is static S1 with ECC-AODV — the campaign's best delay result. High-throughput points in the $3000{+}$~Kbps range correspond to static configs with many flows; they show all three protocols clustered together.}}{28}{figure.caption.34}\protected@file@percent }
\newlabel{fig:scatter-delay-tput}{{25}{28}{Delay vs.\ Throughput scatter across all 48 data points. Ideal points are in the upper-left (high throughput, low delay). ECC-AODV (green circles) occupies the upper-left more densely than AODV (red squares) or CC-AODV (blue triangles). The point at $(164, 1299)$ is static S1 with ECC-AODV — the campaign's best delay result. High-throughput points in the $3000{+}$~Kbps range correspond to static configs with many flows; they show all three protocols clustered together}{figure.caption.34}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.25}PDR vs. Throughput Scatter — All 48 Points}{28}{subsection.8.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces PDR vs.\ Throughput across all 48 runs. High-PDR points (left cluster, $>30\%$) are mobile configs with sparse density; low-PDR points are high-load/high-density. ECC-AODV's point at $(51.71, 1973)$ is M3 — the furthest right in the mid-range cluster, confirming ECC-AODV achieves both higher delivery and higher throughput simultaneously.}}{28}{figure.caption.35}\protected@file@percent }
\newlabel{fig:scatter-pdr-tput}{{26}{28}{PDR vs.\ Throughput across all 48 runs. High-PDR points (left cluster, $>30\%$) are mobile configs with sparse density; low-PDR points are high-load/high-density. ECC-AODV's point at $(51.71, 1973)$ is M3 — the furthest right in the mid-range cluster, confirming ECC-AODV achieves both higher delivery and higher throughput simultaneously}{figure.caption.35}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.26}Static: Area Multiplier Effect on PDR}{29}{subsection.8.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces Static PDR vs.\ area multiplier. Larger area $\Rightarrow $ more sparse $\Rightarrow $ more multi-hop paths available. ECC-AODV excels at \texttt  {a5} ($36.5\%$) where multiple alternative routes exist for MMPS to select the best one. At \texttt  {a1} (dense, single-hop) all three protocols are equally capacity-limited.}}{29}{figure.caption.36}\protected@file@percent }
\newlabel{fig:pdr-area}{{27}{29}{Static PDR vs.\ area multiplier. Larger area $\Rightarrow $ more sparse $\Rightarrow $ more multi-hop paths available. ECC-AODV excels at \texttt {a5} ($36.5\%$) where multiple alternative routes exist for MMPS to select the best one. At \texttt {a1} (dense, single-hop) all three protocols are equally capacity-limited}{figure.caption.36}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.27}Static: Throughput vs. Area Multiplier}{29}{subsection.8.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Static throughput vs.\ area multiplier. The two points at the same area value represent different node counts / flow counts at that density. ECC-AODV achieves the highest throughput at \texttt  {a4} ($+22\%$ over AODV, $+34\%$ over CC-AODV) — S2 config where MMPS path selection gives more stable flows. At \texttt  {a3} (medium density) the n40 configs produce the highest throughputs of the entire campaign ($>3800$~Kbps).}}{29}{figure.caption.37}\protected@file@percent }
\newlabel{fig:tput-area}{{28}{29}{Static throughput vs.\ area multiplier. The two points at the same area value represent different node counts / flow counts at that density. ECC-AODV achieves the highest throughput at \texttt {a4} ($+22\%$ over AODV, $+34\%$ over CC-AODV) — S2 config where MMPS path selection gives more stable flows. At \texttt {a3} (medium density) the n40 configs produce the highest throughputs of the entire campaign ($>3800$~Kbps)}{figure.caption.37}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.28}Static: Delay vs. Area Multiplier}{30}{subsection.8.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces Static delay by area multiplier (avg.\ across configs sharing the same area value). ECC-AODV reduces delay most strongly at \texttt  {a5} ($164$~ms vs.\ $335$~ms AODV) — sparse topology with multi-hop paths where MMPS avoids the slow relay. At \texttt  {a3} ECC-AODV also has a slight edge. At \texttt  {a1} (dense) all protocols saturate the same bottleneck links.}}{30}{figure.caption.38}\protected@file@percent }
\newlabel{fig:delay-area}{{29}{30}{Static delay by area multiplier (avg.\ across configs sharing the same area value). ECC-AODV reduces delay most strongly at \texttt {a5} ($164$~ms vs.\ $335$~ms AODV) — sparse topology with multi-hop paths where MMPS avoids the slow relay. At \texttt {a3} ECC-AODV also has a slight edge. At \texttt {a1} (dense) all protocols saturate the same bottleneck links}{figure.caption.38}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.29}Per-Config Energy — Mobile Topology}{30}{subsection.8.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces Per-config energy on the mobile topology. Bars for the three protocols are almost exactly equal in each config group — energy is dominated by node count and simulation duration, not routing decisions. The protocol overhead of ECC-AODV's additional processing is immeasurably small at the PHY layer.}}{30}{figure.caption.39}\protected@file@percent }
\newlabel{fig:energy-mobile}{{30}{30}{Per-config energy on the mobile topology. Bars for the three protocols are almost exactly equal in each config group — energy is dominated by node count and simulation duration, not routing decisions. The protocol overhead of ECC-AODV's additional processing is immeasurably small at the PHY layer}{figure.caption.39}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.30}Per-Config Energy — Static Topology}{31}{subsection.8.30}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces Per-config energy on the static topology. As with the mobile topology, energy is virtually identical across protocols for each configuration. ECC-AODV is marginally lowest at S1 ($672$~J vs.\ $674$~J for AODV) because it delivers packets more efficiently in the sparse regime with fewer retransmissions.}}{31}{figure.caption.40}\protected@file@percent }
\newlabel{fig:energy-static}{{31}{31}{Per-config energy on the static topology. As with the mobile topology, energy is virtually identical across protocols for each configuration. ECC-AODV is marginally lowest at S1 ($672$~J vs.\ $674$~J for AODV) because it delivers packets more efficiently in the sparse regime with fewer retransmissions}{figure.caption.40}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.31}Loss by Flow Count — Both Topologies}{31}{subsection.8.31}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {32}{\ignorespaces Mobile packet loss by flow count. ECC-AODV achieves the lowest loss at $f{=}10$ flows ($39.6\%$ vs.\ $46.4\%$ for CC-AODV and $48.3\%$ for AODV). This is the M3 outlier ($48.29\% \to 30.85\%$) bringing the average down strongly. At $f{\geq }30$ all protocols saturate above $94\%$ loss and converge.}}{31}{figure.caption.41}\protected@file@percent }
\newlabel{fig:loss-flows-mob}{{32}{31}{Mobile packet loss by flow count. ECC-AODV achieves the lowest loss at $f{=}10$ flows ($39.6\%$ vs.\ $46.4\%$ for CC-AODV and $48.3\%$ for AODV). This is the M3 outlier ($48.29\% \to 30.85\%$) bringing the average down strongly. At $f{\geq }30$ all protocols saturate above $94\%$ loss and converge}{figure.caption.41}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.32}Delay by Flow Count — Mobile Topology}{32}{subsection.8.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces Mobile E2E delay by flow count. CC-AODV achieves the lowest delay at $f{=}10$ because its fixed threshold happens to gate the right paths in sparse configs. ECC-AODV leads at $f{\geq }30$ — consistent with MMPS avoiding congested relays as traffic increases. AODV delay grows monotonically with flow count; ECC-AODV's growth is the flattest above $f{=}20$.}}{32}{figure.caption.42}\protected@file@percent }
\newlabel{fig:delay-flows-mob}{{33}{32}{Mobile E2E delay by flow count. CC-AODV achieves the lowest delay at $f{=}10$ because its fixed threshold happens to gate the right paths in sparse configs. ECC-AODV leads at $f{\geq }30$ — consistent with MMPS avoiding congested relays as traffic increases. AODV delay grows monotonically with flow count; ECC-AODV's growth is the flattest above $f{=}20$}{figure.caption.42}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.33}Mobile: Per-Protocol PDR Trend}{32}{subsection.8.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {34}{\ignorespaces Cumulative PDR across all 8 mobile configs. The gap between ECC-AODV and the baselines widens from config~3 onward, driven by the large $+13$~pp win at M3. By the end of the 8-config sweep, ECC-AODV has accumulated $167.1\%$ total PDR vs.\ $151.6\%$ for CC-AODV and $146.6\%$ for AODV — a $13.9\%$ total-PDR advantage over the 8-config mobile sweep.}}{32}{figure.caption.43}\protected@file@percent }
\newlabel{fig:pdr-cumulative}{{34}{32}{Cumulative PDR across all 8 mobile configs. The gap between ECC-AODV and the baselines widens from config~3 onward, driven by the large $+13$~pp win at M3. By the end of the 8-config sweep, ECC-AODV has accumulated $167.1\%$ total PDR vs.\ $151.6\%$ for CC-AODV and $146.6\%$ for AODV — a $13.9\%$ total-PDR advantage over the 8-config mobile sweep}{figure.caption.43}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.34}Static: Per-Config Delay Comparison}{33}{subsection.8.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {35}{\ignorespaces Horizontal bar chart of static E2E delay per configuration. ECC-AODV's $164$~ms bar at S1 is strikingly shorter than AODV ($335$~ms) and CC-AODV ($293$~ms). At S3 ECC-AODV also beats CC-AODV ($188$ vs.\ $190$). At S8 all bars are $\sim 500{+}$~ms — the dense network bottleneck.}}{33}{figure.caption.44}\protected@file@percent }
\newlabel{fig:delay-static-hbar}{{35}{33}{Horizontal bar chart of static E2E delay per configuration. ECC-AODV's $164$~ms bar at S1 is strikingly shorter than AODV ($335$~ms) and CC-AODV ($293$~ms). At S3 ECC-AODV also beats CC-AODV ($188$ vs.\ $190$). At S8 all bars are $\sim 500{+}$~ms — the dense network bottleneck}{figure.caption.44}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.35}Mobile: Per-Config Delay Comparison}{33}{subsection.8.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {36}{\ignorespaces Horizontal bar chart of mobile E2E delay per configuration. CC-AODV achieves the shortest bar at M3 ($206$~ms) by chance of its fixed threshold picking a short path; ECC-AODV is $266$~ms and AODV $303$~ms. ECC-AODV beats AODV in every configuration, and beats CC-AODV at M4, M5, M6, M7, M8 — the five denser/busier configs.}}{33}{figure.caption.45}\protected@file@percent }
\newlabel{fig:delay-mobile-hbar}{{36}{33}{Horizontal bar chart of mobile E2E delay per configuration. CC-AODV achieves the shortest bar at M3 ($206$~ms) by chance of its fixed threshold picking a short path; ECC-AODV is $266$~ms and AODV $303$~ms. ECC-AODV beats AODV in every configuration, and beats CC-AODV at M4, M5, M6, M7, M8 — the five denser/busier configs}{figure.caption.45}{}}
